```{=html}
<h2 class="section-title d-flex justify-content-between align-items-center pt-0 pb-0 mt-0 mb-1" style="font-size: 20px;">
  <%= templateParams["section-title"] %>
  <iconify-icon icon="<%= templateParams['section-icon'] %>"></iconify-icon>
</h2>
<div class="timeline">
  <% for (const item of items) { %>
    <div class="timeline-item mb-1" <%= metadataAttrs(item) %>>
      <div class="timeline-dot"></div>
      <div class="mb-0">
        <div class="d-flex justify-content-between align-items-center mb-0">
          <h3 class="mt-0 mb-0" style="font-size: 16px;"><%= item.organization || item.institution %></h3>
          <span class="text-end text-muted" style="font-family: monospace; letter-spacing: -0.02em; font-size: 13px;"><%= item.period || (item.begin + "–" + item.end) %></span>
        </div>
        <div class="d-flex justify-content-between align-items-baseline">
          <h4 class="mt-0 mb-0" style="font-size: 16px;"><%= item.title || (item.degree + " " + item.field) %></h4>
          <% if (item.location && item.location.trim() !== '') { %>
            <span class="float-end text-muted fst-italic" style="white-space: nowrap; font-size: 13px;"><%= item.location %></span>
          <% } %>
        </div>
      </div>
      <% if (item.notes && item.notes.length > 0) { %>
        <div class="class="mt-0" style="font-size: 12px; font-weight: 400;">
          <ul class="mb-0" style="padding-left: 16px;">
            <% for (const note of item.notes) { %>
              <li><%= note %></li>
            <% } %>
          </ul>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
```
